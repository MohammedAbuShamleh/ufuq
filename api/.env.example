APP_NAME=UFUQ
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Browser origins allowed to call the API (comma separated): the site, for the
# contact form, and the dashboard. Production:
# CORS_ALLOWED_ORIGINS=https://ufuq.ps,https://admin.ufuq.ps
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# The dashboard's origin (host[:port]): the only one that gets a cookie session on
# /admin/v1. Locally the dashboard calls the API as http://localhost:8000, which is
# same-site with localhost:5173 (APP_URL stays 127.0.0.1 for media URLs). Production:
# SANCTUM_STATEFUL_DOMAINS=admin.ufuq.ps
# SESSION_DOMAIN=.ufuq.ps
# SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=localhost:5173

# After a dashboard save the API posts the touched cache tags to the site, which
# refreshes just those pages. REVALIDATE_SECRET is any long random string, the
# same in web/.env. Production:
# FRONTEND_REVALIDATE_URL=https://ufuq.ps/api/revalidate
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=

# The dashboard, for the «فتحها في اللوحة» link in new-lead emails. Production:
# ADMIN_URL=https://admin.ufuq.ps
ADMIN_URL=http://localhost:5173
