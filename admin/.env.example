# The admin API. Locally it must be "localhost" (not 127.0.0.1): the dashboard runs on
# localhost:5173, and the session cookie only travels between same-site hosts.
VITE_API_URL=http://localhost:8000/admin/v1
# The public site, for the «open in the site» links.
VITE_SITE_URL=http://localhost:3000

# Production:
# VITE_API_URL=https://api.ufuq.ps/admin/v1
# VITE_SITE_URL=https://ufuq.ps
